NEXT_PUBLIC_RESOURCES_BASE_URL=https://github.com/psikolele/wt-biennio/releases/download/v1.0.0-assets

# Password area docenti (lunga, generata da password manager)
TEACHER_PASSWORD=

# Chiave di firma dei cookie di sessione, separata dalla password (es. `openssl rand -hex 32`)
SESSION_SECRET=

# Password di accesso selettivo per ciascuna delle 5 classi.
# Obbligatorie: se mancano, l'accesso alla classe viene negato (nessun valore di default).
CLASS_1_PASSWORD=
CLASS_2_PASSWORD=
CLASS_3_PASSWORD=
CLASS_4_PASSWORD=
CLASS_5_PASSWORD=
